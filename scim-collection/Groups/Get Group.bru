meta {
  name: Get Group
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

docs {
  Get a specific group by ID
  
  Returns the complete group resource including all members.
  Requires SCIM API key authentication.
}