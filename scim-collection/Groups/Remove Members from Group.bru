meta {
  name: Remove Members from Group
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
    "Operations": [
      {
        "op": "remove",
        "path": "members[value eq \"{{userId}}\"]"
      }
    ]
  }
}

docs {
  Remove members from a group via PATCH
  
  Removes specific users from the group using a filter expression.
  
  The path uses SCIM filter syntax to identify which members to remove:
  - members[value eq "userId"] removes the member with matching user ID
  
  Multiple remove operations can be included in a single PATCH request.
  
  Requires SCIM API key authentication.
}