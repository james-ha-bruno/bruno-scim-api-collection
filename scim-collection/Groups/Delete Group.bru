meta {
  name: Delete Group
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

docs {
  Delete a group
  
  Permanently removes the group and all its member associations.
  This does not delete the users, only the group membership.
  
  Requires SCIM API key authentication.
}