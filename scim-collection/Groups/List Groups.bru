meta {
  name: List Groups
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/scim/v2/Groups?startIndex=1&count=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

params:query {
  startIndex: 1
  count: 100
  ~filter: displayName eq "Developers"
}

docs {
  List all groups via SCIM
  
  Returns a paginated list of groups with their members.
  
  Query Parameters:
  - startIndex: Starting index for pagination (default: 1)
  - count: Number of results per page (default: 100)
  - filter: SCIM filter expression (e.g., displayName eq "Developers")
  - sortBy: Attribute to sort by
  - sortOrder: ascending or descending
  
  Requires SCIM API key authentication.
}