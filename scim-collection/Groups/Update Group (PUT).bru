meta {
  name: Update Group (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
    "id": "{{groupId}}",
    "displayName": "Developers",
    "members": [
      {
        "value": "{{userId}}"
      }
    ]
  }
}

docs {
  Update group via PUT (full replacement)
  
  Replaces the entire group resource with the provided data.
  All fields should be included, even if unchanged.
  
  Requires SCIM API key authentication.
}