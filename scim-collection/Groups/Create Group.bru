meta {
  name: Create Group
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/scim/v2/Groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
    "displayName": "Developers",
    "members": []
  }
}

docs {
  Create a new group via SCIM
  
  Creates a new group in the system. Members can be added during creation
  or later via PATCH operations.
  
  Required fields:
  - displayName: The name of the group
  
  Optional fields:
  - members: Array of member objects with value (user ID)
  - description: Group description
  
  Requires SCIM API key authentication.
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.id) {
      bru.setVar("groupId", data.id);
    }
  }
}