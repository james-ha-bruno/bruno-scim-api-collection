meta {
  name: Add Members to Group
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
    "Operations": [
      {
        "op": "add",
        "path": "members",
        "value": [
          {
            "value": "{{userId}}"
          }
        ]
      }
    ]
  }
}

docs {
  Add members to a group via PATCH
  
  Adds one or more users to the group without affecting existing members.
  
  The value field should contain the user's ID.
  Multiple users can be added in a single operation.
  
  Requires SCIM API key authentication.
}