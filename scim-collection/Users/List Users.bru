meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/scim/v2/Users?startIndex=1&count=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

params:query {
  startIndex: 1
  count: 100
  ~filter: userName eq "user@example.com"
}

docs {
  List all users via SCIM
  
  Returns a paginated list of users. Supports filtering, sorting, and pagination.
  
  Query Parameters:
  - startIndex: Starting index for pagination (default: 1)
  - count: Number of results per page (default: 100)
  - filter: SCIM filter expression (e.g., userName eq "user@example.com")
  - sortBy: Attribute to sort by (e.g., userName)
  - sortOrder: ascending or descending
  
  Requires SCIM API key authentication.
}