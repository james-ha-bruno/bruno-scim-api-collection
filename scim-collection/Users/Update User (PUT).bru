meta {
  name: Update User (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/scim/v2/Users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
    "id": "{{userId}}",
    "userName": "john.doe@example.com",
    "name": {
      "givenName": "Johnn",
      "familyName": "Doe"
    },
    "emails": [
      {
        "value": "john.doe@example.com",
        "primary": true
      }
    ],
    "active": true
  }
}

docs {
  Update user via PUT (full replacement)
  
  Replaces the entire user resource with the provided data.
  All fields should be included, even if unchanged.
  
  Setting active to false will deactivate the user and send a deactivation email.
  
  Requires SCIM API key authentication.
}