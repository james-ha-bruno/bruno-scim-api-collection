meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/scim/v2/Users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
    "userName": "john.doe@example.com",
    "name": {
      "givenName": "John",
      "familyName": "Doe"
    },
    "emails": [
      {
        "value": "john.doe@example.com",
        "primary": true
      }
    ],
    "active": true
  }
}

docs {
  Create a new user via SCIM
  
  Creates a new user in the Bruno license system. The user will receive an email
  with their license key automatically.
  
  Required fields:
  - userName: Usually the user's email
  - emails: Array with at least one email object
  
  Optional fields:
  - name: Given name and family name
  - active: User status (default: true)
  
  Requires SCIM API key authentication.
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.id) {
      bru.setVar("userId", data.id);
    }
  }
}