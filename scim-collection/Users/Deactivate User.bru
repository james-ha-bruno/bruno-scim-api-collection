meta {
  name: Deactivate User
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/scim/v2/Users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{scimApiKey}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
    "Operations": [
      {
        "op": "replace",
        "path": "active",
        "value": false
      }
    ]
  }
}

docs {
  Deactivate a user (soft delete)
  
  Sets the user's active status to false. This is a soft delete operation.
  The user will be excluded from user counts and lists.
  
  An email notification will be sent to the user about the deactivation.
  
  Requires SCIM API key authentication.
}